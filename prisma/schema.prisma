// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  ID               Int       @id @default(autoincrement())
  NombreUsuario    String    @unique
  Contraseña       String
  email            String    @unique
  HorasTransmision Int
  Monedas          Int
  ImagenPerfil     String
  NivelStreams     Int
  Puntos           Int
  fechaCreacion    DateTime  @default(now())

  regalos               Regalo[]
  videos                Video[]
  logros                Logros[]

  streamerSuscripciones Suscripcion[] @relation("StreamerSuscripciones")
  viewerSuscripciones   Suscripcion[] @relation("ViewerSuscripciones")

  streamerCHat ChatStreamer[] @relation("streamerCHat")
  viewerEnChat ChatStreamer[] @relation("viewerEnChat")
}

model ChatStreamer {
  ID_Streamer Int
  ID_Viewer   Int
  NivelViewer Int     @default(0)
  Habilitado  Boolean @default(true)

  streamerC Usuario @relation("streamerCHat", fields: [ID_Streamer], references: [ID])
  viewerC   Usuario @relation("viewerEnChat", fields: [ID_Viewer], references: [ID])

  @@id([ID_Streamer, ID_Viewer])
}

model Suscripcion {
  ID_Streamer Int
  ID_Viewer   Int

  streamer Usuario @relation("StreamerSuscripciones", fields: [ID_Streamer], references: [ID])
  viewer   Usuario @relation("ViewerSuscripciones", fields: [ID_Viewer], references: [ID])

  @@id([ID_Streamer, ID_Viewer])
}

model Regalo {
  ID_Regalo         Int     @id @default(autoincrement())
  NombreRegalo      String
  PrecioRegalo      Int
  DescripcionRegalo String
  icono             String
  ID_Streamer       Int

  streamer Usuario @relation(fields: [ID_Streamer], references: [ID])
}

model Categoria {
  ID     Int    @id @default(autoincrement())
  Nombre String
  juegos Juego[]
}

model Juego {
  ID_Juego   Int      @id @default(autoincrement())
  Nombre      String
  Descripcion String?
  CategoriaID Int

  categoria Categoria @relation(fields: [CategoriaID], references: [ID])
  videos    Video[]
}

model Video {
  ID_Video    Int      @id @default(autoincrement())
  Titulo      String
  Url         String
  Duracion    Int?
  FechaSubida DateTime @default(now())
  ID_Juego    Int
  ID_Usuario  Int

  juego   Juego   @relation(fields: [ID_Juego], references: [ID_Juego])
  usuario Usuario @relation(fields: [ID_Usuario], references: [ID])
}

model Logros {
  ID_Logro  Int     @id @default(autoincrement())
  Nombre    String  @unique
  Puntaje   Int
  Completado Boolean @default(false)
  ID_Usuario Int

  usuario Usuario @relation(fields: [ID_Usuario], references: [ID])
}